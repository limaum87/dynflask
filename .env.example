# Configurações do Banco de Dados
MYSQL_DATABASE=dynflaskdb
MYSQL_USER=dynflaskuser
MYSQL_PASSWORD=your_strong_password
MYSQL_ROOT_PASSWORD=your_very_strong_root_password

# Credenciais da API do Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# Configurações da Aplicação Flask
FLASK_APP=main.py
# Mantenha FALSE em produção. Debug=True expõe o console do Werkzeug (RCE).
FLASK_DEBUG=False
# Gere uma chave forte: openssl rand -hex 32
SECRET_KEY=troque_por_uma_chave_forte_aleatoria

# Usuário administrador inicial (criado no primeiro boot se não houver usuários).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e exibida no log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
